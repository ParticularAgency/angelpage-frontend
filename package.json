{
  "name": "angelpage-frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=26.13.1"
  },
  "browserslist": [
    "> 1%"
  ],
  "scripts": {
    "dev": "next dev",
    "dev:webpack": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "check": "lint-staged && npm run test && npm run typecheck && npm run build",
    "verify": "npm run format:check && npm run test && npm run typecheck && npm run build && npm run test:e2e",
    "prepare": "husky"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.15.0",
    "@sendgrid/mail": "^8.1.6",
    "@sentry/nextjs": "^11.17.0",
    "@stripe/react-stripe-js": "^7.1.0",
    "@stripe/stripe-js": "^10.3.0",
    "axios": "^1.21.1",
    "bcryptjs": "^3.0.3",
    "chart.js": "^4.6.2",
    "date-fns": "^4.4.0",
    "exceljs": "^4.4.0",
    "framer-motion": "^14.14.0",
    "googleapis": "^190.0.0",
    "i18n-iso-countries": "^7.14.0",
    "isomorphic-dompurify": "^4.8.0",
    "lucide-react": "^1.79.0",
    "moment": "^2.31.0",
    "next": "^16.4.6",
    "next-auth": "^4.24.15",
    "react": "^19.3.1",
    "react-chartjs-2": "^5.3.1",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "react-redux": "^9.3.1",
    "react-toastify": "^11.2.0",
    "react-zoom-pan-pinch": "^4.4.0",
    "recharts": "^3.11.1",
    "redux": "^5.0.1",
    "redux-persist": "^6.0.0",
    "redux-thunk": "^3.1.0",
    "socket.io-client": "^4.8.4",
    "swiper": "^14.4.0",
    "use-debounce": "^10.1.1",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "daisyui": "^5.8.2",
    "eslint": "^10.15.0",
    "eslint-config-next": "^16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "husky": "^9.1.7",
    "jsdom": "^31.0.1",
    "lint-staged": "^17.6.2",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,css,md,json,mjs,mts}": "prettier --write"
  },
  "overrides": {
    "next-auth": {
      "next": "$next",
      "react": "$react",
      "react-dom": "$react-dom"
    }
  }
}
