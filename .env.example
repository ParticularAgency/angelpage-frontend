NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me

# Stripe publishable key only. The secret key stays on the backend.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Show Test/Demo notice banners (defaults on in non-production builds)
# NEXT_PUBLIC_SHOW_ENV_BANNER=true
# NEXT_PUBLIC_ENV_BANNER_TEXT=Test Mode

# Public site used for canonical URLs, sitemap, and Open Graph
NEXT_PUBLIC_SITE_URL=https://www.angelpage.shop

# Google Tag Manager and GA4. Defaults are set in code if these are omitted.
NEXT_PUBLIC_GTM_ID=GTM-WP5JZ5K5
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-Z789BPWQED

# Indexing is on unless this is false
# NEXT_PUBLIC_ALLOW_INDEXING=false

# OAuth — Google/Facebook buttons on login & register when set
# Redirect URIs: {NEXTAUTH_URL}/api/auth/callback/google and .../callback/facebook
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
# Optional: same App ID as FACEBOOK_CLIENT_ID — enables richer Facebook share popup
NEXT_PUBLIC_FACEBOOK_APP_ID=

# Social auto-posting is configured on the backend (META_*, TIKTOK_*).
# Sellers choose per-listing channels in Sell an item → Price step or Account → Listings.

# Sentry. Leave these unset to disable error reporting.
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_DSN=
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=angelpage-frontend

# Cloudflare Turnstile — https://dash.cloudflare.com/?to=/:account/turnstile
# Widget hidden on login/register/reset when site key unset (local dev).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
