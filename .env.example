NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me

# Show Test/Demo notice banners (defaults on in non-production builds)
# NEXT_PUBLIC_SHOW_ENV_BANNER=true
# NEXT_PUBLIC_ENV_BANNER_TEXT=Test Mode

# Allow search engines to index (also removes X-Robots-Tag noindex header)
# NEXT_PUBLIC_ALLOW_INDEXING=true

# OAuth — Google/Facebook buttons on login & register when set
# Redirect URIs: {NEXTAUTH_URL}/api/auth/callback/google and .../callback/facebook
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
# Optional: same App ID as FACEBOOK_CLIENT_ID — enables richer Facebook share popup
NEXT_PUBLIC_FACEBOOK_APP_ID=

# Social auto-posting is configured on the backend (META_*, TIKTOK_*).
# Sellers choose per-listing channels in Sell an item → Price step or Account → Listings.

# Cloudflare Turnstile — https://dash.cloudflare.com/?to=/:account/turnstile
# Widget hidden on login/register/reset when site key unset (local dev).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
